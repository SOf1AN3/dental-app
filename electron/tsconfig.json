{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Types Node.js (`process`, `__dirname`) + typage `import.meta.env` d'electron-vite.
    "types": ["node", "electron-vite/node"],
    // Alias `@/` identique à la racine (`tsconfig.json`) : le main importe
    // désormais `src/lib/sync/*` et `src/lib/db/*` (protocol, desktop-db…).
    // Vite ne lit PAS ce `paths` : l'alias correspondant est dans
    // `electron.vite.config.ts` (section `main`).
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts"]
}
