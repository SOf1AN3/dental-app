# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefacts de compilation — NE JAMAIS les committer
# Un .js a cote de son .ts S'INTERCALE entre le code source et son execution :
# Node/le resolveur preferent le .js, donc TOUTE modification du .ts est
# silencieusement ignoree au runtime. 15 de ces fichiers etaient committes et
# s'executaient (constate via la trace d'erreur d'un test).
/src/**/*.js
/src/**/*.jsx

# local database data
/pgdata

# log files
*.log

# tool-generated workspace dirs
.opencode/
.playwright-mcp/
